PORT=3000
PROJECT_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=echoes
DB_SSL=false

JWT_SECRET=change-me-in-production

# Prefer REDIS_URL for managed Redis (Upstash, etc). rediss:// enables TLS.
# REDIS_URL=rediss://default:PASSWORD@assuring-wren-107186.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_TLS=true

# Outbox publisher + enrichment worker
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_BATCH_SIZE=50
ENRICHMENT_JOB_ATTEMPTS=5
EMBEDDING_JOB_ATTEMPTS=5

# AI provider for embeddings + RAG answers.
# gemini | openai | fake
# When unset: OpenAI if OPENAI_API_KEY is set, otherwise Gemini if GEMINI_API_KEY is set, otherwise fake.
# AI_PROVIDER=gemini

# Gemini free tier (Google AI Studio). Vectors are requested at 1536 dimensions.
# GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_LLM_MODEL=gemini-3.8-flash
# Gemini 3 rejects "none". "low" leaves room in max_tokens for the answer.
GEMINI_REASONING_EFFORT=low
GEMINI_EMBEDDING_TIMEOUT_MS=20000
GEMINI_LLM_TIMEOUT_MS=30000

# OpenAI. Used when AI_PROVIDER=openai, or when this key is set and AI_PROVIDER is empty.
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_TIMEOUT_MS=10000
OPENAI_LLM_TIMEOUT_MS=30000
RAG_SIMILARITY_THRESHOLD=0.25
RAG_DEFAULT_LIMIT=8

# Comma-separated allowed origins in non-development environments
# CORS_ORIGIN=https://app.example.com,https://staging.example.com
